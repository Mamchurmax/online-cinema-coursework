# Copy to .env and adjust values. Never commit .env.

# PostgreSQL (used by docker-compose)
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema
POSTGRES_DB=cinema
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Adminer (DB browser) starts only with: docker compose --profile tools up -d adminer
ADMINER_PORT=8080

# Backend
# For local runs outside Docker. In Docker Compose DATABASE_URL is set automatically.
DEBUG=false
DATABASE_URL=postgresql+psycopg://cinema:cinema@localhost:5432/cinema
CORS_ORIGINS=["http://localhost:5173"]

# JWT: generate a secret, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Administrator created by `python -m scripts.seed` (password: at least 8 characters)
ADMIN_EMAIL=admin@cinema.local
ADMIN_PASSWORD=

# TMDB API read access token (https://www.themoviedb.org/settings/api)
TMDB_API_TOKEN=
