@startuml class
!include _style.iuml
title Онлайн-кінотеатр — діаграма класів усієї системи (огляд)

' Overview: every class and relation, members hidden. Members are shown in the
' detailed views: class-catalog, class-playback, class-billing,
' class-recommendations, class-reports.
hide members
left to right direction
skinparam ranksep 70

package "core" {
  class Settings <<Singleton>> SINGLETON {
    - {static} _instance : Settings
    + database_url : str
    + jwt_secret_key : str
    + tmdb_api_token : str
    + {static} instance() : Settings
  }
}

package "api.v1" {
  class AuthRouter <<router>> {
    + register(body : RegisterRequest) : UserRead
    + login(form) : TokenResponse
  }
  class MeRouter <<router>> {
    + read_me(user : User) : UserRead
  }
  class CatalogRouter <<router>> {
    + search_titles(filters : CatalogFilters) : TitlePage
    + get_title(title_id) : TitleDetail
    + list_genres() : list[GenreRead]
    + list_countries() : list[CountryRead]
  }
  class RecommendationsRouter <<router>> {
    + recommendations(strategy, limit) : list[RecommendationRead]
  }
  class AdminRouter <<router>> {
    + create_title / update_title / delete_title
    + import_title(tmdb_id, type)
    + add_season / add_episode / attach_video
    + update_plan / set_user_role / delete_user
  }
  class BillingRouter <<router>> {
    + list_plans() : list[PlanRead]
    + pay(plan_code, scenario) : PaymentRead
    + simulate_bank_response(payment_id, approved) : PaymentRead
    + resolve_payment(payment_id, approved) : PaymentRead
  }
  class ReportsRouter <<router>> {
    + list_reports() : list[ReportInfo]
    + build_report(code, date_from, date_to) : ReportRead
  }
  class PlaybackRouter <<router>> {
    + start_title(title_id) : PlaybackInfo
    + start_episode(episode_id) : PlaybackInfo
    + master_playlist(asset_id) : m3u8
  }
}

package "services" {
  class AuthService {
    + register(email, password, display_name) : User
    + login(email, password) : str
    + get_user_by_token(token) : User
  }

  package "catalog" {
    class CatalogService <<Director>> BUILDER {
      + search(filters : CatalogFilters) : TitlePage
      + get_title(title_id) : Title
      + list_genres() : list[Genre]
      + list_countries() : list[Country]
    }

    class CatalogQueryBuilder <<Builder>> BUILDER {
      - _conditions : list
      - _order_by : list
      + with_text(text) : CatalogQueryBuilder
      + with_type(type) : CatalogQueryBuilder
      + with_genres(ids) : CatalogQueryBuilder
      + with_countries(codes) : CatalogQueryBuilder
      + released_between(from, to) : CatalogQueryBuilder
      + with_min_rating(rating) : CatalogQueryBuilder
      + sorted_by(sort, order) : CatalogQueryBuilder
      + paginate(page, size) : CatalogQueryBuilder
      + build() : CatalogQuery
    }

    class CatalogQuery <<Product>> BUILDER {
      + statement : Select
      + count_statement : Select
      + page : int
      + page_size : int
    }
  }

  package "billing" {
    class PlanService {
      + ensure_default_plans() : list[Plan]
      + current_plan(user_id) : Plan
    }
    class SubscriptionService {
      + activate(user_id, plan_id) : Subscription
      + check_expiring() : (int, int)
    }
  }

  package "payments" {
    class PaymentService {
      - _provider : PaymentProvider
      + pay(user, plan_code, scenario) : Payment
      + simulate_bank_response(user, id, approved) : Payment
      + resolve_by_admin(id, approved) : Payment
      - _apply(payment, result) : Payment
    }

    abstract class PaymentProviderFactory <<Creator>> FACTORY {
      + {abstract} create_provider() : PaymentProvider
      + provider() : PaymentProvider
    }
    class MockPaymentProviderFactory <<ConcreteCreator>> FACTORY {
      + create_provider() : PaymentProvider
    }
    abstract class PaymentProvider <<Product>> FACTORY {
      + code : str
      + {abstract} charge(payment) : ChargeResult
      + {abstract} bank_response(payment, approved) : ChargeResult
    }
    class MockPaymentProvider <<ConcreteProduct>> FACTORY {
      + charge(payment) : ChargeResult
      + bank_response(payment, approved) : ChargeResult
    }

    class PaymentContext <<Context>> STATE {
      + payment : Payment
      + state : PaymentState
      + transition_to(state)
      + succeed()
      + fail()
    }
    abstract class PaymentState <<State>> STATE {
      + status : PaymentStatus
      + is_final : bool
      + succeed(context)
      + fail(context)
    }
    class PendingState <<ConcreteState>> STATE
    class SucceededState <<ConcreteState>> STATE
    class FailedState <<ConcreteState>> STATE
  }

  package "events" {
    class EventBus OBSERVER {
      - _listeners : dict[type, list[Listener]]
      + subscribe(event_type, listener)
      + unsubscribe(event_type, listener)
      + publish(event)
    }
    interface EventPublisher <<Subject>> OBSERVER {
      + publish(event)
    }
    class StatisticsListener <<Observer>> OBSERVER {
      + on_title_watched(event)
    }
    class NotificationListener <<Observer>> OBSERVER {
      + on_payment_succeeded(event)
      + on_payment_failed(event)
      + on_subscription_activated(event)
      + on_subscription_expiring(event)
    }
    class SubscriptionActivationListener <<Observer>> OBSERVER {
      + on_payment_succeeded(event)
    }
    class DomainEvent <<event>>
    class TitleWatched <<event>>
    class PaymentSucceeded <<event>>
    class PaymentFailed <<event>>
    class SubscriptionExpiring <<event>>
    class SubscriptionActivated <<event>>
  }

  package "notifications" {
    class NotificationService {
      + notify(user_id, type, message) : Notification
      + latest(user) : list[Notification]
      + mark_read(user, ids) : int
    }
  }

  package "recommendations" {
    class RecommendationService <<Context>> {
      - _strategies : dict[str, RecommendationStrategy]
      + recommend(user, strategy, limit) : list[Recommendation]
      + profile(user) : UserProfile
    }
    abstract class RecommendationStrategy <<Strategy>> STRATEGY {
      + code : str
      + {abstract} recommend(profile, limit) : list[Recommendation]
    }
    class GenreBasedStrategy <<ConcreteStrategy>> STRATEGY {
      + recommend(profile, limit)
    }
    class PopularityStrategy <<ConcreteStrategy>> STRATEGY {
      + recommend(profile, limit)
    }
    class HybridStrategy <<ConcreteStrategy>> STRATEGY {
      - _parts : list[(RecommendationStrategy, float)]
      + recommend(profile, limit)
    }
    class UserProfile {
      + genre_weights : Counter[int]
      + seen_title_ids : set[int]
    }
  }

  package "admin" {
    class CatalogAdminService {
      + create_title(fields) : Title
      + update_title(id, fields) : Title
      + import_from_tmdb(tmdb_id, type) : Title
      + add_season(title_id, number, name) : Season
      + add_episode(season_id, fields) : Episode
    }
    class AccountsAdminService {
      + search_users(query, page, size)
      + set_role(actor, user_id, role) : User
      + update_plan(plan_id, fields) : Plan
    }
  }

  package "reports" {
    class ReportService {
      - _reports : dict[str, type[BaseReport]]
      + available() : list[type[BaseReport]]
      + period(date_from, date_to) : ReportPeriod
      + build(code, date_from, date_to) : ReportResult
    }
    abstract class "BaseReport[RawT, DataT]" as BaseReport <<AbstractClass>> TEMPLATE {
      + {static} code : str
      + {static} title : str
      # _repository : ReportRepository
      + build(period) : ReportResult <<final, template method>>
      # {abstract} collect(period) : RawT
      # {abstract} aggregate(raw, period) : DataT
      # {abstract} format(data, period) : ReportBody
      # notes(data) : list[str] <<hook>>
    }
    class PopularityReport <<ConcreteClass>> TEMPLATE {
      # collect / aggregate / format
      # notes(data)
    }
    class ActivityReport <<ConcreteClass>> TEMPLATE {
      # collect / aggregate / format
      # notes(data)
    }
    class RevenueReport <<ConcreteClass>> TEMPLATE {
      # collect / aggregate / format
      # notes(data)
    }
    class ReportPeriod <<value>> {
      + start : date
      + end : date
      + by_month : bool
      + buckets() : list[date]
      + bucket_of(moment) : date
    }
    class ReportResult <<value>> {
      + code : str
      + period : ReportPeriod
      + metrics : list[Metric]
      + charts : list[Chart]
      + table : Table
      + notes : list[str]
    }
  }

  package "favorites" {
    class FavoriteService {
      + add(user, title_id)
      + remove(user, title_id)
      + titles(user) : list[Title]
    }
  }

  package "streaming" {
    class PlaybackService <<Context>> {
      + start_title(user, title_id) : PlaybackSession
      + start_episode(user, episode_id) : PlaybackSession
      + master_playlist(user, asset_id) : str
      - _policy(user) : PlaybackPolicy
      - _pick_ad() : AdInfo
    }

    abstract class PlaybackPolicy <<Strategy>> STRATEGY {
      + plan : Plan
      + max_quality : str
      + allowed_qualities(available) : list[str]
      + {abstract} requires_preroll_ad() : bool
    }
    class FreePolicy <<ConcreteStrategy>> STRATEGY {
      + requires_preroll_ad() : bool = true
    }
    class PremiumPolicy <<ConcreteStrategy>> STRATEGY {
      + requires_preroll_ad() : bool = false
    }

    interface StreamSource <<Subject>> PROXY {
      + master_playlist(asset : VideoAsset) : str
    }
    class HlsFileStreamSource <<RealSubject>> PROXY {
      - _hls_root : Path
      + master_playlist(asset) : str
    }
    class StreamAccessProxy <<Proxy>> PROXY {
      - _source : StreamSource
      - _policy : PlaybackPolicy
      + master_playlist(asset) : str
      - _keep_variants(playlist, allowed) : str
    }

    class WatchHistoryService {
      + save_progress(user, asset_id, position) : WatchHistory
      + resume_position(user, asset_id) : int
      + continue_watching(user) : list[WatchHistory]
      + history(user) : list[WatchHistory]
    }

    class MediaLibraryService {
      + attach_to_movie(tmdb_id, stream_dir) : VideoAsset
      + register_ad(name, stream_dir) : Ad
    }
  }

  package "importers" {
    interface CatalogSource <<Target>> ADAPTER {
      + get_movie(external_id) : TitleData
      + get_series(external_id, max_seasons) : TitleData
      + get_popular_ids(title_type, pages) : list[int]
      + get_anime_ids(title_type, pages) : list[int]
    }

    class TmdbAdapter <<Adapter>> ADAPTER {
      - _client : TmdbClient
      - _country_names : dict[str, str]
      + get_movie(external_id) : TitleData
      + get_series(external_id, max_seasons) : TitleData
      + get_popular_ids(title_type, pages) : list[int]
      + get_anime_ids(title_type, pages) : list[int]
      - _localized_texts(raw, title_key) : (str, str)
    }

    class TmdbClient <<Adaptee>> ADAPTER {
      + movie(id, language) : dict
      + tv(id, language) : dict
      + tv_season(id, number, language) : dict
      + popular(media, page, language) : dict
      + discover(media, page, language, filters) : dict
      + countries(language) : list[dict]
    }

    class TitleData <<dataclass>> {
      + external_id : int
      + type : TitleType
      + title : str
      + genres : list[GenreData]
      + countries : list[CountryData]
      + seasons : list[SeasonData]
    }

    class CatalogImportService {
      - _excluded_genre_ids : frozenset[int]
      - _max_episodes : int
      + import_movies(ids) : ImportReport
      + import_series(ids, max_seasons) : ImportReport
      + import_popular(type, pages) : ImportReport
      + import_anime(type, pages) : ImportReport
    }
  }
}

package "repositories" {
  class UserRepository {
    + get_by_id(id) : User
    + get_by_email(email) : User
    + save(user) : User
  }
  class TitleRepository {
    + get_by_tmdb_id(tmdb_id) : Title
    + get_with_details(id) : Title
    + find_page(statement, count_statement) : (list[Title], int)
    + add(title)
  }
  class GenreRepository {
    + list_all() : list[Genre]
  }
  class CountryRepository {
    + list_all() : list[Country]
  }
  class VideoAssetRepository {
    + get_for_title(title_id) : VideoAsset
    + get_for_episode(episode_id) : VideoAsset
  }
  class AdRepository {
    + list_active() : list[Ad]
  }
  class PlanRepository {
    + get_by_code(code) : Plan
  }
  class SubscriptionRepository {
    + get_active(user_id, now) : Subscription
  }
  class RecommendationRepository {
    + viewing_signals(user_id) : list[ViewingSignal]
    + titles_with_genres(genre_ids, exclude, limit) : list[Title]
    + popular_titles(exclude, limit) : list[Title]
  }
  class ReportRepository {
    + watch_rows(start, end) : list[WatchRow]
    + registrations(start, end) : list[datetime]
    + payments(start, end) : list[PaymentRow]
    + active_subscriptions_by_plan(at) : dict[str, int]
  }
  class WatchHistoryRepository {
    + get(user_id, asset_id) : WatchHistory
    + list_recent(user_id, limit) : list[WatchHistory]
  }
}

package "models" {
  class User {
    + email : str
    + password_hash : str
    + role : UserRole
  }
  class Title {
    + tmdb_id : int
    + type : TitleType
    + title : str
    + rating : Decimal
    + watch_count : int
  }
  class Genre
  class Country
  class Season
  class Episode
  class VideoAsset {
    + hls_path : str
    + qualities : list[str]
    + duration_sec : int
  }
  class Ad {
    + hls_path : str
    + active : bool
  }
  class Payment {
    + amount : Decimal
    + scenario : PaymentScenario
    + status : PaymentStatus
  }
  class Plan {
    + code : str
    + max_quality : str
    + has_ads : bool
  }
  class Subscription {
    + status : SubscriptionStatus
    + expires_at : datetime
  }
  class WatchHistory {
    + progress_sec : int
    + completed : bool
    + last_watched_at : datetime
  }
}

AuthRouter --> AuthService
MeRouter ..> AuthService : get_current_user
MeRouter --> WatchHistoryService : /me/history
MeRouter --> FavoriteService : /me/favorites
MeRouter --> NotificationService : /me/notifications
AuthService --> UserRepository
AuthService ..> Settings
UserRepository ..> User

CatalogRouter --> CatalogService
CatalogService ..> CatalogQueryBuilder : керує кроками
CatalogQueryBuilder ..> CatalogQuery : будує
CatalogService --> TitleRepository
CatalogService --> GenreRepository
CatalogService --> CountryRepository
TitleRepository ..> CatalogQuery : виконує

TmdbAdapter ..|> CatalogSource
TmdbAdapter --> TmdbClient : адаптує
TmdbAdapter ..> TitleData : створює
CatalogImportService --> CatalogSource
CatalogImportService --> TitleRepository
CatalogImportService --> GenreRepository
CatalogImportService --> CountryRepository
TitleRepository ..> Title
GenreRepository ..> Genre
CountryRepository ..> Country

PlaybackRouter --> PlaybackService
PlaybackService --> PlanService : тариф користувача
PlaybackService ..> PlaybackPolicy : обирає стратегію
PlaybackService ..> StreamSource : працює через інтерфейс
PlaybackService --> VideoAssetRepository
PlaybackService --> AdRepository
PlaybackService --> WatchHistoryService : позиція продовження
WatchHistoryService --> WatchHistoryRepository
WatchHistoryRepository ..> WatchHistory
WatchHistory "*" --> "1" VideoAsset
FreePolicy --|> PlaybackPolicy
PremiumPolicy --|> PlaybackPolicy
HlsFileStreamSource ..|> StreamSource
StreamAccessProxy ..|> StreamSource
StreamAccessProxy o--> HlsFileStreamSource : делегує
StreamAccessProxy --> PlaybackPolicy : які якості дозволені
PlanService --> PlanRepository
PlanService --> SubscriptionRepository
MediaLibraryService --> VideoAssetRepository
MediaLibraryService --> AdRepository
VideoAssetRepository ..> VideoAsset
AdRepository ..> Ad
PlanRepository ..> Plan
SubscriptionRepository ..> Subscription
PlaybackPolicy --> Plan

BillingRouter --> PaymentService
PaymentService --> PaymentProviderFactory : factory method
PaymentProviderFactory ..> PaymentProvider : створює
MockPaymentProviderFactory --|> PaymentProviderFactory
MockPaymentProvider --|> PaymentProvider
MockPaymentProviderFactory ..> MockPaymentProvider : створює
PaymentService ..> PaymentContext : переходи статусу
PaymentContext o--> PaymentState : поточний стан
PendingState --|> PaymentState
SucceededState --|> PaymentState
FailedState --|> PaymentState
PaymentContext --> Payment
PaymentService --> EventPublisher : публікує події

EventBus ..|> EventPublisher
EventBus o--> "*" StatisticsListener
EventBus o--> "*" NotificationListener
EventBus o--> "*" SubscriptionActivationListener
TitleWatched --|> DomainEvent
PaymentSucceeded --|> DomainEvent
SubscriptionActivated --|> DomainEvent
PaymentFailed --|> DomainEvent
SubscriptionExpiring --|> DomainEvent
WatchHistoryService --> EventPublisher : TitleWatched
StatisticsListener --> TitleRepository : watch_count + 1
SubscriptionActivationListener --> SubscriptionService : activate()
SubscriptionService --> EventPublisher : SubscriptionActivated
NotificationListener --> NotificationService

RecommendationsRouter --> RecommendationService
RecommendationService o--> "3" RecommendationStrategy : обирає за кодом
RecommendationService ..> UserProfile : будує
GenreBasedStrategy --|> RecommendationStrategy
PopularityStrategy --|> RecommendationStrategy
HybridStrategy --|> RecommendationStrategy
HybridStrategy o--> "*" RecommendationStrategy : зважує результати
GenreBasedStrategy --> RecommendationRepository
PopularityStrategy --> RecommendationRepository
RecommendationService --> RecommendationRepository

ReportsRouter --> ReportService
ReportService ..> BaseReport : створює за кодом, викликає build()
PopularityReport --|> BaseReport
ActivityReport --|> BaseReport
RevenueReport --|> BaseReport
BaseReport --> ReportRepository : collect()
BaseReport ..> ReportResult : повертає
ReportResult *-- ReportPeriod
ReportRepository ..> WatchHistory
ReportRepository ..> Payment
ReportRepository ..> Subscription

AdminRouter --> CatalogAdminService
AdminRouter --> AccountsAdminService
AdminRouter --> MediaLibraryService : відео, реклама
CatalogAdminService ..> CatalogImportService : імпорт з TMDB (Adapter)
CatalogAdminService --> TitleRepository

Title "1" o-- "*" Genre
Title "1" o-- "*" Country
Title "1" *-- "*" Season
Season "1" *-- "*" Episode
Title "1" -- "0..1" VideoAsset
Episode "1" -- "0..1" VideoAsset
Subscription "*" --> "1" Plan
User "1" -- "*" Subscription

@enduml
