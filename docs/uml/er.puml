@startuml er
title Онлайн-кінотеатр — ER-діаграма бази даних

hide circle
skinparam linetype ortho
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3B6EA8
  HeaderBackgroundColor #E8F0FB
}

' PK — первинний ключ, FK — зовнішній ключ, UQ — унікальне значення

package "Користувачі" #F7F7F7 {
  entity users {
    * id : serial <<PK>>
    --
    * email : varchar(255) <<UQ>>
    * password_hash : varchar(255)
    * display_name : varchar(100)
    avatar_url : varchar(500)
    * role : user_role {user, admin}
    * created_at : timestamptz
  }

  entity notifications {
    * id : serial <<PK>>
    --
    * user_id : int <<FK>>
    * type : notification_type
    * message : text
    * is_read : bool
    * created_at : timestamptz
  }
}

package "Каталог" #F2F8F2 {
  entity titles {
    * id : serial <<PK>>
    --
    tmdb_id : int <<UQ>>
    * type : title_type {movie, series}
    * title : varchar(255)
    * description : text
    release_year : int
    rating : numeric(3,1)
    poster_url : varchar(500)
    backdrop_url : varchar(500)
    duration : int
    * created_at : timestamptz
  }

  entity genres {
    * id : serial <<PK>>
    --
    tmdb_id : int <<UQ>>
    * name : varchar(100) <<UQ>>
  }

  entity countries {
    * id : serial <<PK>>
    --
    * code : char(2) <<UQ>>
    * name : varchar(100)
  }

  entity title_genres {
    * title_id : int <<PK, FK>>
    * genre_id : int <<PK, FK>>
  }

  entity title_countries {
    * title_id : int <<PK, FK>>
    * country_id : int <<PK, FK>>
  }

  entity seasons {
    * id : serial <<PK>>
    --
    * title_id : int <<FK>>
    * number : int
    * name : varchar(255)
    UQ (title_id, number)
  }

  entity episodes {
    * id : serial <<PK>>
    --
    * season_id : int <<FK>>
    * number : int
    * name : varchar(255)
    * description : text
    duration : int
    UQ (season_id, number)
  }
}

package "Медіа" #FFF8EE {
  entity video_assets {
    * id : serial <<PK>>
    --
    title_id : int <<FK, UQ>>
    episode_id : int <<FK, UQ>>
    * hls_path : varchar(500)
    * qualities : json
    * duration_sec : int
    * created_at : timestamptz
    CHECK рівно одне з title_id / episode_id
  }

  entity ads {
    * id : serial <<PK>>
    --
    * name : varchar(255)
    * hls_path : varchar(500)
    * active : bool
    * created_at : timestamptz
  }
}

package "Активність" #F5F2FA {
  entity watch_history {
    * id : serial <<PK>>
    --
    * user_id : int <<FK>>
    * video_asset_id : int <<FK>>
    * progress_sec : int
    * completed : bool
    * last_watched_at : timestamptz
    UQ (user_id, video_asset_id)
  }

  entity favorites {
    * user_id : int <<PK, FK>>
    * title_id : int <<PK, FK>>
    --
    * created_at : timestamptz
  }
}

package "Підписки й оплата" #FBF1F1 {
  entity plans {
    * id : serial <<PK>>
    --
    * code : varchar(50) <<UQ>>
    * name : varchar(100)
    * price : numeric(10,2)
    * period_days : int
    * max_quality : varchar(10)
    * has_ads : bool
  }

  entity subscriptions {
    * id : serial <<PK>>
    --
    * user_id : int <<FK>>
    * plan_id : int <<FK>>
    * status : subscription_status
    * started_at : timestamptz
    * expires_at : timestamptz
  }

  entity payments {
    * id : serial <<PK>>
    --
    * user_id : int <<FK>>
    * plan_id : int <<FK>>
    * amount : numeric(10,2)
    * provider : varchar(50)
    * scenario : payment_scenario
    * status : payment_status
    * created_at : timestamptz
    * updated_at : timestamptz
  }
}

users ||--o{ notifications
users ||--o{ subscriptions
users ||--o{ payments
users ||--o{ watch_history
users ||--o{ favorites

titles ||--o{ title_genres
genres ||--o{ title_genres
titles ||--o{ title_countries
countries ||--o{ title_countries
titles ||--o{ seasons
seasons ||--o{ episodes
titles ||--o{ favorites

titles |o--o| video_assets
episodes |o--o| video_assets
video_assets ||--o{ watch_history

plans ||--o{ subscriptions
plans ||--o{ payments

@enduml
